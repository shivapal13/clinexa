# Database (PostgreSQL / Neon)
# e.g., postgresql://username:password@localhost:5432/clinexa_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/clinexa_db

# Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Cache & Celery Broker
REDIS_URL=redis://localhost:6379/0

# SMTP Mail Configuration
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-email@example.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Administrator Access (comma-separated if multiple)
ADMIN_EMAIL=admin@clinexa.com


